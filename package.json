{
  "name": "iuroadmap",
  "version": "1.0.0",
  "description": "AI-Powered Career Roadmap Platform",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "iuroadmap.webapp/apps/*",
    "iuroadmap.webapp/packages/*",
    "iuroadmap.services/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "# ========== SETUP =========": "",
    "install-all": "npm ci",
    "bootstrap": "npm install && npm run build",
    "clean": "npm run clean --workspaces --if-present && node -e \"require('fs').rmSync('node_modules', {recursive: true, force: true})\" && node -e \"require('fs').rmSync('coverage', {recursive: true, force: true})\"",
    "# ========== DEVELOPMENT =========": "",
    "gen:spec": "npm --prefix iuroadmap.services/api-gateway run swagger:export",
    "gen:api": "npm run gen:spec && npm run generate --workspace=@iuroadmap/api-gen",
    "gen:api:hooks": "npm run gen:spec && npm run generate:hooks --workspace=@iuroadmap/api-gen",
    "gen:api:zod": "npm run gen:spec && npm run generate:zod --workspace=@iuroadmap/api-gen",
    "dev": "turbo run start:dev dev --parallel",
    "start": "turbo run start --parallel",
    "web:dev": "turbo run dev --filter=iuroadmap.web",
    "mobile:start": "turbo run start --filter=iuroadmap.mobile",
    "mobile:android": "turbo run android --filter=iuroadmap.mobile",
    "mobile:ios": "turbo run ios --filter=iuroadmap.mobile",
    "# ========== BUILD =========": "",
    "build": "turbo run build",
    "prebuild": "npm run clean",
    "# ========== DATABASE MIGRATIONS =========": "",
    "migrate": "turbo run migrate --parallel",
    "# ========== LINTING & FORMATTING =========": "",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "validate": "npm run lint && npm run format:check && npm run typecheck",
    "validate:fix": "npm run lint:fix && npm run format",
    "# ========== TYPE CHECKING =========": "",
    "typecheck": "turbo run typecheck",
    "# ========== UNIT TESTS (No Database) =========": "",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:unit:watch": "turbo run test:unit:watch",
    "test:unit:debug": "turbo run test:unit:debug",
    "# ========== GIT HOOKS ==========": "",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^8.50.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.0.0",
    "turbo": "^2.5.3",
    "typescript": "^5.2.0"
  }
}
