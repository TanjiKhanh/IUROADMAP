  "info": {
    "title": "IUROADMAP API Gateway",
    "description": "Unified OpenAPI Specification for IUROADMAP Microservices Network",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LearnerRegisterRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The email address of the learner",
            "example": "learner@example.com"
          },
          "password": {
            "type": "string",
            "description": "The account password (minimum 6 characters)",
            "example": "password123"
          },
          "name": {
            "type": "string",
            "description": "Full name of the learner",
            "example": "John Doe"
          },
          "role": {
            "type": "string",
            "description": "Role of the user",
            "enum": [
              "STUDENT"
            ],
            "example": "STUDENT"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MentorRegisterRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The email address of the mentor",
            "example": "mentor@example.com"
          },
          "password": {
            "type": "string",
            "description": "The account password (minimum 6 characters)",
            "example": "password123"
          },
          "name": {
            "type": "string",
            "description": "Full name of the mentor",
            "example": "Dr. Jane Smith"
          },
          "role": {
            "type": "string",
            "description": "Role of the user",
            "enum": [
              "MENTOR"
            ],
            "example": "MENTOR"
          },
          "bio": {
            "type": "string",
            "description": "A brief biography or summary of experience",
            "example": "Senior Data Scientist with 10+ years in Fintech."
          },
          "cvUrl": {
            "type": "string",
            "description": "URL to the mentor CV/Resume",
            "example": "https://example.com/cv/janesmith.pdf"
          },
          "linkedinUrl": {
            "type": "string",
            "description": "LinkedIn profile URL",
            "example": "https://linkedin.com/in/janesmith"
          },
          "industry": {
            "type": "string",
            "description": "Industry category",
            "example": "BUSINESS_ANALYTICS"
          },
          "skills": {
            "description": "Array of skill tags",
            "example": [
              "SQL",
              "Python",
              "Machine Learning"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "email",
          "password",
          "name",
          "role",
          "cvUrl",
          "industry",
          "skills"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "description": "User password",
            "example": "password123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthLoginResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT Access token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "access_token"
        ]
      },
      "ForgotPasswordRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User email address to send reset instructions",
            "example": "user@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token received via email",
            "example": "abc123token"
          },
          "newPassword": {
            "type": "string",
            "description": "New password",
            "example": "newSecurePassword123!"
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "User ID"
          },
          "email": {
            "type": "string",
            "description": "Email address"
          },
          "name": {
            "type": "string",
            "description": "Full name"
          },
          "roleId": {
            "type": "string",
            "description": "Role ID"
          },
          "status": {
            "type": "string",
            "description": "Account status",
            "enum": [
              "PENDING_APPROVAL",
              "ACTIVE",
              "BANNED",
              "REJECTED"
            ]
          },
          "subscriptionTier": {
            "type": "string",
            "description": "Subscription tier",
            "enum": [
              "FREE",
              "VIP",
              "PRO"
            ]
          },
          "subscriptionExpiresAt": {
            "format": "date-time",
            "type": "string",
            "description": "Subscription expiration date"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Creation timestamp"
          },
          "canDelete": {
            "type": "boolean",
            "description": "Whether the current user can delete this record"
          },
          "canUpdate": {
            "type": "boolean",
            "description": "Whether the current user can update this record"
          }
        },
        "required": [
          "id",
          "email",
          "roleId",
          "status",
          "subscriptionTier",
          "createdAt"
        ]
      },
      "UserCreateRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address",
            "example": "user@iuroadmap.com"
          },
          "password": {
            "type": "string",
            "description": "Password (min 6 characters)",
            "example": "SecurePass123"
          },
          "name": {
            "type": "string",
            "description": "Full name",
            "example": "Nguyen Van A"
          },
          "roleId": {
            "type": "string",
            "description": "Role ID to assign",
            "example": "uuid-role-id"
          }
        },
        "required": [
          "email",
          "password",
          "roleId"
        ]
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Record ID to update"
          },
          "name": {
            "type": "string",
            "description": "Full name",
            "example": "Nguyen Van A"
          },
          "roleId": {
            "type": "string",
            "description": "Role ID to assign",
            "example": "uuid-role-id"
          },
