              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mentor registered successfully along with mentor profile"
          },
          "400": {
            "description": "Bad Request / Validation Error"
          },
          "409": {
            "description": "Email or Username already exists"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
