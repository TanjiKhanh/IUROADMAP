    "/api/v1/iam/User/GetByIndex": {
      "get": {
        "operationId": "UsersController_getByIndex",
        "summary": "Filter and paginate users",
        "parameters": [
          {
            "name": "rowsPerPage",
            "required": false,
            "in": "query",
            "description": "Number of rows per page",
            "schema": {
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "currentPage",
            "required": false,
            "in": "query",
            "description": "Current page number",
            "schema": {
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "keyword",
            "required": false,
            "in": "query",
            "description": "Search keyword matching name or email",
            "schema": {
              "example": "keyword",
              "type": "string"
            }
          },
          {
            "name": "roleId",
            "required": false,
            "in": "query",
            "description": "Filter by role ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Filter by account status",
            "schema": {
              "enum": [
                "PENDING_APPROVAL",
                "ACTIVE",
                "BANNED",
                "REJECTED"
              ],
              "type": "string"
            }
          },
          {
            "name": "subscriptionTier",
            "required": false,
            "in": "query",
            "description": "Filter by subscription tier",
            "schema": {
              "enum": [
                "FREE",
                "VIP",
                "PRO"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users retrieved successfully"
          }
        },
        "tags": [
          "IAM - Users"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
