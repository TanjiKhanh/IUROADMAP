# Build context = repository root, for the backend Dockerfiles (iuroadmap.services/<service>/Dockerfile)
# and the web one (iuroadmap.webapp/apps/web/Dockerfile).
# Nested folders need the **/ prefix: a bare pattern only matches at the context root.

# Installed / built output (the image installs and builds its own)
**/node_modules
**/dist
**/build
**/coverage
**/.turbo
**/*.tsbuildinfo
npm-debug.log

# Secrets: variables come from Railway (or --env-file), never from the image
**/.env
**/.env.*

# Not needed by any image
.git
.github
.husky
.vscode
.idea
.claude
.agent
agent
_bmad
_bmad-output
iuroadmap.docs
iuroadmap.webapp/tests
test-results
**/*.log
**/.DS_Store
