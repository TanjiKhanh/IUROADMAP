{
  "name": "@iuroadmap/api-gen",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "orval --config ./orval.config.ts",
    "generate:hooks": "orval --config ./orval.config.ts --project iuroadmapApi",
    "generate:zod": "orval --config ./orval.config.ts --project iuroadmapZod",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "zod": ">=3.22.0"
  },
  "devDependencies": {
    "orval": "^8.20.0",
    "typescript": "^5.1.6"
  }
}
